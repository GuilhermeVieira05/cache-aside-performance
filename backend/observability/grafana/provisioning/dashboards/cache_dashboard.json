     },
     "expr": "avg_over_time({job=\"nestjs\"} |= \"[CACHE HIT]\" | regexp `duration=(?P<duration>[0-9.]+)ms` | unwrap duration [1m])",
     "legendFormat": "Cache HIT"
    },
    {
     "datasource": {
