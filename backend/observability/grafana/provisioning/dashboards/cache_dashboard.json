{
  "title": "Cache Aside — Performance Dashboard",
  "uid": "cache-aside-perf",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cache Hits (total)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"rails\"} |= \"[CACHE HIT]\" [1h]))",
          "legendFormat": "Hits"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache Misses (total)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"rails\"} |= \"[CACHE MISS]\" [1h]))",
          "legendFormat": "Misses"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache Hit Rate (%)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"rails\"} |= \"[CACHE HIT]\" [1h])) / (sum(count_over_time({job=\"rails\"} |= \"[CACHE HIT]\" [1h])) + sum(count_over_time({job=\"rails\"} |= \"[CACHE MISS]\" [1h]))) * 100",
          "legendFormat": "Hit Rate %"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Invalidações (total)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"rails\"} |= \"[CACHE INVALIDATE]\" [1h]))",
          "legendFormat": "Invalidações"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache Hits vs Misses ao longo do tempo",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Hits" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Misses" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"rails\"} |= \"[CACHE HIT]\" [1m]))",
          "legendFormat": "Hits"
        },
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"rails\"} |= \"[CACHE MISS]\" [1m]))",
          "legendFormat": "Misses"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Invalidações de Cache ao longo do tempo",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"rails\"} |= \"[CACHE INVALIDATE]\" [1m]))",
          "legendFormat": "Invalidações"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requisições HTTP ao longo do tempo",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"rails\"} |~ \"Completed [0-9]\" [1m]))",
          "legendFormat": "Requisições"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Logs de Cache em tempo real",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 8 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"rails\"} |~ \"\\\\[CACHE\"",
          "legendFormat": ""
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
