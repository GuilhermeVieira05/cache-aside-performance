      "uid": "loki"
     },
     "expr": "avg_over_time({job=\"nestjs\"} |= \"[REQUEST]\" | regexp `duration=(?P<duration>\\d+)ms` | unwrap duration [$__range])",
     "legendFormat": "Avg response"
    }
   ]
  },
  {
   "id": 8,
   "type": "logs",
   "title": "Logs de Cache em tempo real",
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 24,
    "h": 8
   },
   "options": {
    "showTime": true,
    "showLabels": false,
    "showCommonLabels": false,
    "wrapLogMessage": true,
    "prettifyLogMessage": false,
    "enableLogDetails": true,
    "sortOrder": "Descending",
    "dedupStrategy": "none"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"nestjs\"} |~ \"\\\\[CACHE\"",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Tempo médio de resposta por tipo (HIT / MISS / SQL sem cache)",
   "description": "Medido pelo CacheService e logado em cada linha [CACHE HIT|MISS|DISABLED] key=... duration=Xms",
   "gridPos": {
    "x": 0,
    "y": 19,
    "w": 24,
    "h": 8
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 100
       },
       {
        "color": "red",
        "value": 500
       }
      ]
     }
    }
   },
   "targets": [
    {
     "datasource": {
